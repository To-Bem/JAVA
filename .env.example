# Copie para .env antes de subir:  cp .env.example .env
# O .env NÃO vai para o GitHub (está no .gitignore).

# ----- Banco Oracle (container tobem-oracle) -----
# Senha dos usuários administrativos SYS/SYSTEM
ORACLE_PASSWORD=TobemOracle2026
# Usuário/esquema da aplicação, criado automaticamente no primeiro start
DB_USER=tobem
DB_PASSWORD=TobemDb2026
DB_PORT=1521

# ----- API (container tobem-api) -----
API_PORT=8080
# Chave Base64 com pelo menos 32 bytes. Gere uma nova com: openssl rand -base64 32
JWT_SECRET=dG9iZW0tZGV2b3BzLWdzLTIwMjYtY2hhdmUtand0LTMyYg==
# Primeiro administrador, criado automaticamente na subida da API
ADMIN_EMAIL=admin@tobem.com
ADMIN_PASSWORD=Admin@12345
# Mostra os comandos SQL nos logs da API (útil para as evidências)
JPA_SHOW_SQL=true
